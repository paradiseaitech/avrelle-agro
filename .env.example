# ============================================================================
# AVRELLE AGRO PVT LTD — environment configuration
# Copy this file to `.env`, fill in real values, and never commit `.env`.
# ============================================================================

# --- Database (PostgreSQL / Supabase) --------------------------------------
# Leave DATABASE_URL empty to develop against the embedded PGlite database at
# .data/pglite (no Docker or Postgres install required).
#
# For Supabase, use a pooler connection string (Dashboard → Connect → Session
# or Transaction pooler). Direct `db.<ref>.supabase.co` connections may be
# IPv6-only and unavailable on some networks. Port 6543 (transaction mode) is
# supported by this app; the server code handles prepared statements and SSL.
# Encode special characters in the password (for example @ -> %40).
#
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
DATABASE_URL=""

# --- Supabase Storage (only needed when IMAGE_STORAGE_PROVIDER="supabase") --
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON KEY]"
# Server-only credential. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="[SERVICE ROLE KEY]"
# Create this bucket in the Supabase dashboard before switching providers.
SUPABASE_STORAGE_BUCKET="product-images"

# --- Image storage provider -------------------------------------------------
# "local"    -> writes to .data/uploads and serves via /api/files/<name>
#               (development / a persistent single-server deployment)
# "supabase" -> uploads to Supabase Storage (recommended for serverless hosting)
IMAGE_STORAGE_PROVIDER="local"

# --- Public site URL --------------------------------------------------------
# Canonical origin used by metadata, sitemap.xml, and robots.txt.
# Use the real https:// domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin bootstrap --------------------------------------------------------
# Used by `npm run db:seed` only when no administrator exists for this email.
# CHANGE THE PASSWORD BEFORE DEPLOYING. Minimum 10 characters.
ADMIN_EMAIL="admin@avrelleagro.in"
ADMIN_PASSWORD="change-me-before-going-live"
ADMIN_NAME="AVRELLE Administrator"

# --- Business contact shown on the storefront -------------------------------
NEXT_PUBLIC_BUSINESS_PHONE="+917979782185"
NEXT_PUBLIC_BUSINESS_EMAIL="averelleagro@gmail.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="917979782185"
